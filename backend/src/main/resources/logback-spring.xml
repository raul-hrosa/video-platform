<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Dev local: console legivel com o correlationId visivel -->
    <springProfile name="!docker &amp; !prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>
                    %d{HH:mm:ss.SSS} %-5level [%X{correlationId:-no-cid}] %logger{36} - %msg %kvp%n
                </pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- Docker / producao: JSON estruturado para STDOUT (compativel com Loki) -->
    <springProfile name="docker | prod">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeContext>false</includeContext>
                <customFields>{"service":"video-platform-backend"}</customFields>
                <includeMdcKeyName>correlationId</includeMdcKeyName>
                <includeMdcKeyName>webhookEventId</includeMdcKeyName>
                <includeMdcKeyName>eventType</includeMdcKeyName>
                <fieldNames>
                    <version>[ignore]</version>
                    <levelValue>[ignore]</levelValue>
                </fieldNames>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>

    <logger name="com.videoplatform" level="${LOGGING_LEVEL_COM_VIDEOPLATFORM:-INFO}"/>

</configuration>
