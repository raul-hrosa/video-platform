# Frontend - usado apenas para rodar o Vite localmente (npm run dev)
# Em Docker, estes valores vêm do .env da raiz via build args.

# URL pública do LiveKit (wss://<projeto>.livekit.cloud)
VITE_LIVEKIT_URL=wss://tele-d083qhvu.livekit.cloud

# Base da API. Local (sem nginx): http://localhost:8081/api
VITE_API_URL=http://localhost:8081/api
