# ============================================================
# Video Platform - variáveis de ambiente (EXEMPLO)
# Copie este arquivo para .env e preencha os valores do LiveKit.
#   cp .env.example .env
# NÃO comite o arquivo .env com credenciais reais.
# ============================================================

# ---- Provider de midia (Sprint 11) ----
# livekit e o unico provider hoje. A chave existe para permitir plugar outro
# adapter no futuro sem mudar os consumidores. Deve casar com VITE_MEDIA_PROVIDER.
MEDIA_PROVIDER=livekit

# ---- LiveKit Cloud ----
# Crie um projeto em https://cloud.livekit.io e pegue estes valores
# em "Settings" > "Keys". A URL tem o formato wss://<projeto>.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Autenticacao (Platform JWT) ----
# Secret HMAC para assinar o JWT da plataforma. Minimo 32 bytes.
# Gere um: openssl rand -base64 48   (ou: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
JWT_SECRET=
JWT_EXPIRATION_SECONDS=3600

# ---- Salas ----
# Intervalo da varredura que expira salas vencidas (ISO-8601 duration).
ROOM_EXPIRATION_CHECK_INTERVAL=PT30S

# ---- CORS ----
# Origens liberadas para /api (lista separada por virgula, ou "*" p/ qualquer uma).
# Padrao "*": a API nao usa cookies, o token vai no header Authorization.
# No Docker o nginx faz proxy same-origin e isso nem se aplica.
APP_CORS_ALLOWED_ORIGINS=*

# ---- PostgreSQL ----
POSTGRES_DB=video_platform
POSTGRES_USER=video
POSTGRES_PASSWORD=video

# ---- Portas expostas no host ----
FRONTEND_PORT=8080
BACKEND_PORT=8081
POSTGRES_PORT=5432

# ---- Frontend (injetado no build) ----
# Provider ativo no browser (livekit). Default: mesmo de MEDIA_PROVIDER.
VITE_MEDIA_PROVIDER=livekit
# URL pública do LiveKit usada pelo browser (normalmente igual a LIVEKIT_URL)
VITE_LIVEKIT_URL=
# Caminho da API a partir do browser. Com o nginx fazendo proxy, deixe /api
VITE_API_URL=/api
